# Base URL of the Submit-A-Day backend (server origin, no /api; inlined into the bundle, so no secrets)
EXPO_PUBLIC_API_URL=http://localhost:3000

# TEMP: true = fake in-memory backend, no server needed (see src/dev/README.md)
EXPO_PUBLIC_USE_MOCKS=true

# GitHub sign-in: the same client ID as GITHUB_CLIENT_ID on the server (public; the secret stays
# on the server). Empty = the GitHub buttons are hidden. Needs a development build or web, not Expo Go.
EXPO_PUBLIC_GITHUB_CLIENT_ID=
